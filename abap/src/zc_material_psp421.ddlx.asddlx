/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*
  Metadata Extension for ZC_Material_PSP421
  Provides UI annotations: List Report + Object Page layout
  Package : ZPSP421_MATERIAL
  Author  : PSP421
 *++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName:       'Material',
  typeNamePlural: 'Materials',
  title:          { type: #STANDARD, label: 'Material',     value: 'Material' },
  description:    { type: #STANDARD, label: 'Description',  value: 'MaterialName' }
}

annotate view ZC_Material_PSP421
  with
{
  /*===========================================================*
   * Object Page – Facets
   *===========================================================*/
  @UI.facet: [
    {
      id:       'GeneralData',
      purpose:  #STANDARD,
      type:     #IDENTIFICATION_REFERENCE,
      label:    'General Data',
      position: 10
    },
    {
      id:       'WeightVolume',
      purpose:  #STANDARD,
      type:     #FIELDGROUP_REFERENCE,
      targetQualifier: 'WeightVolume',
      label:    'Weight & Volume',
      position: 20
    }
  ]

  /*===========================================================*
   * Material (key)
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 10, importance: #HIGH, label: 'Material' }],
    identification: [{ position: 10 }],
    selectionField: [{ position: 10 }]
  }
  @Search.defaultSearchElement: true
  Material;

  /*===========================================================*
   * Material Description (text)
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 20, importance: #HIGH, label: 'Description' }],
    identification: [{ position: 20 }],
    selectionField: [{ position: 20 }]
  }
  MaterialName;

  /*===========================================================*
   * Material Type
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 30, importance: #MEDIUM }],
    identification: [{ position: 30 }],
    selectionField: [{ position: 30 }]
  }
  MaterialType;

  /*===========================================================*
   * Industry Sector
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 40, importance: #LOW }],
    identification: [{ position: 40 }]
  }
  IndustrySector;

  /*===========================================================*
   * Material Group
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 50, importance: #MEDIUM }],
    identification: [{ position: 50 }],
    selectionField: [{ position: 40 }]
  }
  MaterialGroup;

  /*===========================================================*
   * Base Unit
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 60, importance: #LOW }],
    identification: [{ position: 60 }]
  }
  BaseUnit;

  /*===========================================================*
   * Weight & Volume group (Object Page field group)
   *===========================================================*/
  @UI: {
    identification:  [{ position: 10 }],
    fieldGroup:      [{ qualifier: 'WeightVolume', position: 10 }]
  }
  GrossWeight;

  @UI: {
    identification:  [{ position: 20 }],
    fieldGroup:      [{ qualifier: 'WeightVolume', position: 20 }]
  }
  NetWeight;

  @UI: {
    identification:  [{ position: 30 }],
    fieldGroup:      [{ qualifier: 'WeightVolume', position: 30 }]
  }
  WeightUnit;

  @UI: {
    identification:  [{ position: 40 }],
    fieldGroup:      [{ qualifier: 'WeightVolume', position: 40 }]
  }
  Volume;

  @UI: {
    identification:  [{ position: 50 }],
    fieldGroup:      [{ qualifier: 'WeightVolume', position: 50 }]
  }
  VolumeUnit;

  /*===========================================================*
   * Dates
   *===========================================================*/
  @UI: {
    lineItem:       [{ position: 100, importance: #MEDIUM, label: 'Created On' }],
    identification: [{ position: 70 }]
  }
  MaterialCreationDate;

  @UI: {
    identification: [{ position: 80 }]
  }
  LastChangeDate;

  /*===========================================================*
   * Old Material Number
   *===========================================================*/
  @UI: {
    identification: [{ position: 90 }]
  }
  OldMaterialNumber;
}

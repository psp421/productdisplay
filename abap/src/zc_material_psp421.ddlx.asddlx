@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName:       'Material',
  typeNamePlural: 'Materials',
  title:          { type: #STANDARD, value: 'Product' },
  description:    { type: #STANDARD, value: 'ProductDescription' }
}

annotate view ZC_MATERIAL_PSP421 with
{
  @UI.facet: [
    { id: 'GeneralData',   purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'General Data',     position: 10 },
    { id: 'WeightVolume',  purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, targetQualifier: 'WeightVolume', label: 'Weight & Volume', position: 20 }
  ]

  @UI: { lineItem: [{ position: 10, importance: #HIGH }], identification: [{ position: 10 }], selectionField: [{ position: 10 }] }
  @Search.defaultSearchElement: true
  Product;

  @UI: { lineItem: [{ position: 20, importance: #HIGH }], identification: [{ position: 20 }], selectionField: [{ position: 20 }] }
  ProductDescription;

  @UI: { lineItem: [{ position: 30, importance: #MEDIUM }], identification: [{ position: 30 }], selectionField: [{ position: 30 }] }
  ProductType;

  @UI: { lineItem: [{ position: 40, importance: #LOW }], identification: [{ position: 40 }] }
  IndustrySector;

  @UI: { lineItem: [{ position: 50, importance: #MEDIUM }], identification: [{ position: 50 }], selectionField: [{ position: 40 }] }
  ProductGroup;

  @UI: { lineItem: [{ position: 60, importance: #LOW }], identification: [{ position: 60 }] }
  ProductHierarchy;

  @UI: { lineItem: [{ position: 70, importance: #LOW }], identification: [{ position: 70 }] }
  BaseUnit;

  @UI: { identification: [{ position: 10 }], fieldGroup: [{ qualifier: 'WeightVolume', position: 10 }] }
  GrossWeight;

  @UI: { identification: [{ position: 20 }], fieldGroup: [{ qualifier: 'WeightVolume', position: 20 }] }
  NetWeight;

  @UI: { identification: [{ position: 30 }], fieldGroup: [{ qualifier: 'WeightVolume', position: 30 }] }
  WeightUnit;

  @UI: { identification: [{ position: 40 }], fieldGroup: [{ qualifier: 'WeightVolume', position: 40 }] }
  Volume;

  @UI: { identification: [{ position: 50 }], fieldGroup: [{ qualifier: 'WeightVolume', position: 50 }] }
  VolumeUnit;

  @UI: { lineItem: [{ position: 100, importance: #MEDIUM }], identification: [{ position: 80 }] }
  ProductCreationDate;

  @UI: { identification: [{ position: 90 }] }
  LastChangeDate;

  @UI: { identification: [{ position: 100 }] }
  OldMaterialNumber;
}
